#!/bin/bash
set -euxo pipefail

dnf install -y python3 python3-pip unzip amazon-cloudwatch-agent

# ---- fetch the application bundle from S3 ----
install -d -m 0755 /opt/app /var/log/catalog
aws s3 cp "s3://${artifacts_bucket}/${app_key}" /tmp/app.zip --region ${region}
unzip -o /tmp/app.zip -d /opt/app

python3 -m venv /opt/app/venv
/opt/app/venv/bin/pip install --upgrade pip
/opt/app/venv/bin/pip install -r /opt/app/requirements.txt

# ---- runtime config: pull DB creds + app secret from SSM ----
ssm() { aws ssm get-parameter --region ${region} --name "$1" --with-decryption --query 'Parameter.Value' --output text; }

dnf install -y amazon-cloudwatch-agent
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c ssm:AmazonCloudWatch-ce-capstone

umask 077
cat > /etc/catalog.env <<EOF
APP_VERSION=${app_version}
APP_ENV=production
PORT=${app_port}
DB_HOST=$(ssm /ce-capstone/db/host)
DB_NAME=$(ssm /ce-capstone/db/name)
DB_USER=$(ssm /ce-capstone/db/user)
DB_PASSWORD=$(ssm /ce-capstone/db/password)
FLASK_SECRET_KEY=$(ssm /ce-capstone/app/secret_key)
EOF

# ---- CloudWatch agent (config lives in SSM, name matches CloudWatchAgentServerPolicy) ----
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c ssm:AmazonCloudWatch-ce-capstone || true

# ---- service ----
cat > /etc/systemd/system/catalog.service <<'UNIT'
[Unit]
Description=CloudCart storefront
After=network-online.target

[Service]
WorkingDirectory=/opt/app
EnvironmentFile=/etc/catalog.env
ExecStart=/opt/app/venv/bin/gunicorn --chdir /opt/app --bind 0.0.0.0:${app_port} --workers 2 --access-logfile /var/log/catalog/app.log --error-logfile /var/log/catalog/app.log app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now catalog
